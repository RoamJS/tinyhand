{
  "name": "tinyhand",
  "version": "0.1.0",
  "description": "Point, tap, and draw over your Roam graph with TinyHand.",
  "main": "extension.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "samepage dev",
    "build:roam": "samepage build --dry",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "roam",
    "roam-research",
    "roamjs"
  ],
  "license": "MIT",
  "dependencies": {
    "roamjs-components": "^0.91.0"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.11"
  },
  "samepage": {
    "extends": "node_modules/roamjs-components/package.json",
    "include": [
      "README.md",
      "package.json",
      "CHANGELOG.md",
      "LICENSE"
    ]
  }
}
